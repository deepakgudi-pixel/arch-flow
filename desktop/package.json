    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Archflow Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.archflow.desktop",
    "productName": "Archflow",
    "mac": {
      "category": "public.app-category.developer-tools",
